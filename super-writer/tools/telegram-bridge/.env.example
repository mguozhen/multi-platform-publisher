# Telegram approval bridge config
# Copy to .env and fill in.

# From @BotFather → /newbot
TELEGRAM_BOT_TOKEN=

# From: python3 bridge.py --discover-chat  (DM the bot "hi" first)
TELEGRAM_CHAT_ID=

# Which hooks module to use:
#   hooks_demo        — proves the loop works, publishes nothing
#   hooks_selfmedia   — real: xhs / linkedin / x publishing
BRIDGE_HOOKS=hooks_demo

# LLM for the regen hook (flatkey gateway, OpenAI-compatible)
LLM_API_KEY=
LLM_BASE_URL=https://flatkey.ai/v1
LLM_MODEL=gpt-5-mini
