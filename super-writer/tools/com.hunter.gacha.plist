<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.hunter.gacha</string>

  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>/Users/hunter/self-media/tools/gacha.py</string>
    <string>--draw</string>
    <string>--push</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/hunter/self-media/tools</string>

  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>8</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>

  <key>StandardOutPath</key>
  <string>/tmp/gacha-cron.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/gacha-cron.log</string>

  <key>RunAtLoad</key>
  <false/>
</dict>
</plist>
